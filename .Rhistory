force(iris)
# For built-in data, there's often a 'help file'
?iris
seq(2,150,2)
iris_evenrows <- iris[c(FALSE, TRUE), ]
print(iris_evenrows)
# 2.  Create a new object called iris_chr which is a copy of iris, except where every column is a character class
char_iris <- iris(lapply(iris, as.character), stringsAsFactors = FALSE)
# 2.  Create a new object called iris_chr which is a copy of iris, except where every column is a character class
char_iris <- data.frame(lapply(iris, as.character), stringsAsFactors = FALSE)
print(char_iris)
# 2.  Create a new object called iris_chr which is a copy of iris, except where every column is a character class
char_iris <- data.frame(lapply(iris, as.character))
str(char_iris)
# 3.  Create a new numeric vector object named "Sepal.Area" which is the product of Sepal.Length and Sepal.Width
Sepal.Area <- Sepal.Length * Sepal.Width
# 3.  Create a new numeric vector object named "Sepal.Area" which is the product of Sepal.Length and Sepal.Width
Sepal.Area <- iris$Sepal.Length * iris$Sepal.Width
# 4.  Add Sepal.Area to the iris data frame as a new column
Iris$Sepal.Area <- iris$Sepal.Length * iris$Sepal.Width
# 4.  Add Sepal.Area to the iris data frame as a new column
iris$Sepal.Area <- iris$Sepal.Length * iris$Sepal.Width
print(iris)
print(Sepal.Area)
# 5.  Create a new dataframe that is a subset of iris using only rows where Sepal.Area is greater than 20
# (name it big_area_iris)
big_area_iris <- iris[iris$Sepal.Area > 20,]
print(big_area_iris)
